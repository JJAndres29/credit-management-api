generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SELLER
}

enum SaleType {
  CASH
  CREDIT
}

enum SaleStatus {
  PAID
  PENDING
  PARTIAL
}

enum InstallmentFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum DocumentType {
  CC  // Cédula de ciudadanía
  CE  // Cédula de extranjería
}

// --- P2: core commerce / accounting (expand-only; dual-write with legacy fields) ---

enum LedgerEntryKind {
  CREDIT_SALE_OPENED
  PAYMENT_RECEIVED
  PAYMENT_ADJUSTED
  PAYMENT_REMOVED
  CREDIT_SALE_REVERSED
  MANUAL_ADJUSTMENT
}

enum StockMovementType {
  SALE_PHYSICAL_DECREMENT
  SALE_PHYSICAL_RESTORE
  SALE_ONLINE_RESERVE
  SALE_ONLINE_RELEASE
  ADJUSTMENT
}

enum AssetType {
  IMAGE
  VIDEO
}

enum ElectronicInvoiceType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum ElectronicInvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  DELIVERED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SELLER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model Client {
  id             String       @id @default(uuid())
  name           String
  phone          String
  email          String?
  documentType   DocumentType
  documentNumber String
  address        String
  neighborhood   String
  creditLimit    Decimal      @db.Decimal(10, 2)
  balance        Decimal      @default(0) @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales             Sale[]
  payments          Payment[]
  auditLogs         AuditLog[]
  notificationLogs  NotificationLog[]
  customer          Customer?
  ledgerEntries     LedgerEntry[]
  fiscalData        CustomerFiscalData?
}

model Product {
  id             String   @id @default(uuid())
  name           String
  description    String?
  /// URL-safe unique handle for storefront SEO (canonical product page)
  slug           String?  @unique
  brand          String?
  metaTitle      String?
  metaDescription String?
  stock          Int      @default(0)
  retailPrice    Decimal? @db.Decimal(10, 2)
  investmentCost Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  categoryId     String?
  /// ISO 4217; dual-write with ProductVariant for future multi-SKU storefront
  currencyCode   String   @default("COP")
  /// IVA % override (e.g. 19, 5, 0). Null → inherit Category.ivaRate or platform default in app code
  ivaRate        Decimal? @db.Decimal(5, 2)
  /// Peso por unidad para envío (kg). El checkout suma (peso × cantidad); null → usa fallback en servidor.
  weightKg       Decimal? @db.Decimal(10, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  saleItems        SaleItem[]
  attributes       ProductAttribute[]
  onlineOrderItems OnlineOrderItem[]
  variants         ProductVariant[]
  assets           ProductAsset[]
  stockMovements   StockMovement[]
  cartItems        CartItem[]
  scopedCoupons    Coupon[]
  slugHistory      ProductSlugHistory[]
  priceExperiments PriceExperiment[]
}

/// Old product slugs → current slug (HTTP 301). Populated when admin changes `Product.slug`.
model ProductSlugHistory {
  id        String   @id @default(uuid())
  oldSlug   String   @unique
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String?  @unique
  description String?
  metaTitle String?
  metaDescription String?
  /// Default IVA % for products in this category (Colombia: 19 / 5 / 0). Null → app default (19).
  ivaRate   Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  attributes CategoryAttribute[]
  coupons    Coupon[]
  discountCampaigns DiscountCampaign[]
}

/// P5 — batch %-off window over a category (complements row-level `Coupon`)
model DiscountCampaign {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(120)
  categoryId  String?
  /// Percent off the category MSRP band (e.g. 15.00 = 15%). Application at checkout is future work.
  percentOff  Decimal  @db.Decimal(5, 2)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([startsAt, endsAt])
}

model PriceExperiment {
  id              String                         @id @default(uuid())
  productId       String
  name            String                         @db.VarChar(120)
  /// Optional cohort key for future assignment (e.g. cookie / customer bucket)
  cohortKey       String?                        @db.VarChar(80)
  priceA          Decimal                        @db.Decimal(10, 2)
  priceB          Decimal                        @db.Decimal(10, 2)
  startAt         DateTime
  endAt           DateTime
  winnerCriteria  PriceExperimentWinnerCriteria  @default(REVENUE)
  isActive        Boolean                        @default(true)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([startAt, endAt])
}

model CategoryAttribute {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   AttributeValue[]

  @@unique([categoryId, name])
}

model AttributeValue {
  id          String   @id @default(uuid())
  attributeId String
  value       String
  createdAt   DateTime @default(now())

  attribute    CategoryAttribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productLinks ProductAttribute[]
  variantLinks VariantAttributeValue[]

  @@unique([attributeId, value])
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String
  valueId   String

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value   AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, valueId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

/// P2: SKU-level inventory (dual-write with Product.stock until reads switch to variant-only)
model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  sku            String?  @unique
  slug           String?  @unique
  label          String?
  stock          Int      @default(0)
  retailPrice    Decimal? @db.Decimal(10, 2)
  investmentCost Decimal? @db.Decimal(10, 2)
  currencyCode   String   @default("COP")
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  /// SHA-256 hash of sorted AttributeValue IDs; enforces unique attribute combinations per product.
  /// NULL for default variants (PostgreSQL treats each NULL as distinct in unique indexes).
  attributeHash  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems        SaleItem[]
  onlineOrderItems OnlineOrderItem[]
  stockMovements   StockMovement[]
  assets           ProductAsset[]
  cartItems        CartItem[]
  attributeValues  VariantAttributeValue[]

  @@unique([productId, attributeHash])
  @@index([productId, isDefault])
}

/// Junction table: links each ProductVariant to the specific AttributeValues that define it.
/// E.g. variant "Rojo + Doble" has two rows: one for Color=Rojo, one for Tamaño=Doble.
model VariantAttributeValue {
  id        String @id @default(uuid())
  variantId String
  valueId   String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([variantId, valueId])
  @@index([valueId])
}

/// P2: richer media metadata (multi-size URLs can be added without breaking existing ProductImage)
model ProductAsset {
  id                 String    @id @default(uuid())
  productId          String
  variantId          String?
  type               AssetType @default(IMAGE)
  position           Int       @default(0)
  altText            String?
  urlOriginal        String
  cloudinaryPublicId String
  createdAt          DateTime  @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  variantId     String?
  movementType  StockMovementType
  quantityDelta Int
  refSaleId     String?
  refOrderId    String?
  note          String?
  createdAt     DateTime          @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model Sale {
  id                String                @id @default(uuid())
  saleNumber        Int                   @unique @default(autoincrement())
  clientId          String
  type              SaleType
  status            SaleStatus            @default(PENDING)
  total             Decimal               @db.Decimal(10, 2)
  currencyCode      String                @default("COP")
  installmentsCount Int?                  // Null para ventas sin plan de cuotas
  frequency         InstallmentFrequency? // MONTHLY | BIWEEKLY — null si no es venta en cuotas
  installmentAmount Decimal?              @db.Decimal(10, 2) // (total - initialPayment) / installmentsCount
  initialPayment    Decimal?              @db.Decimal(10, 2) // Cuota inicial abonada al crear la venta (puede ser 0 o null)
  collectionDay     Int?                  // Día del mes para el cobro (1-31). Ej: 30 → cobra el día 30 de cada mes
  collectionDay2    Int?                  // Segundo día de cobro para planes BIWEEKLY. Ej: 15 → cobra el 15 y el collectionDay
  createdAt         DateTime              @default(now())

  client         Client         @relation(fields: [clientId], references: [id])
  items               SaleItem[]
  payments            Payment[]
  ledgerEntries       LedgerEntry[]
  electronicInvoices  ElectronicInvoice[]

  // Partial composite index on (type, status, collectionDay) WHERE installmentsCount IS NOT NULL.
  // Prisma DSL does not support partial indexes — managed by raw migration
  // 20260506000000_add_active_credit_sales_index as "Sale_active_credit_idx".
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  /// P2 dual-write: default variant for this product at sale time (nullable for pre-P2 rows)
  variantId   String?
  quantity    Int
  basePrice   Decimal? @db.Decimal(10, 2) // Precio base del producto al momento de la venta (snapshot)
  unitPrice   Decimal  @db.Decimal(10, 2) // Precio final aplicado (puede incluir recargo de crédito)
  subtotal    Decimal  @db.Decimal(10, 2)
  appliedRule String?                     // Regla de pricing aplicada: "CASH_BASE" | "CREDIT_SURCHARGE_15PCT" | etc.

  sale    Sale           @relation(fields: [saleId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([variantId])
}

model Payment {
  id           String   @id @default(uuid())
  clientId     String
  saleId       String?
  amount       Decimal  @db.Decimal(10, 2)
  currencyCode String   @default("COP")
  note         String?
  createdAt    DateTime @default(now())

  client        Client        @relation(fields: [clientId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  ledgerEntries LedgerEntry[]

  // Composite index: accelerates bulk-load of payments by saleId (used by dashboard & GetCollectionsUseCase).
  // Created by migration 20260506000000_add_active_credit_sales_index.
  @@index([saleId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  clientId  String
  userId    String
  action    String
  before    Decimal  @db.Decimal(10, 2)
  after     Decimal  @db.Decimal(10, 2)
  ip        String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model NotificationLog {
  id           String   @id @default(uuid())
  clientId     String
  channel      String   // "WHATSAPP" | "EMAIL"
  event        String   // "PAYMENT_REGISTERED" | "CREDIT_SALE_CREATED"
  status       String   // "SENT" | "FAILED"
  errorMessage String?
  sentAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Customer {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String?
  phone              String
  googleId           String?  @unique
  isActive           Boolean  @default(true)
  clientId           String?  @unique
  mustChangePassword Boolean  @default(false)
  address            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client             Client?              @relation(fields: [clientId], references: [id])
  onlineOrders       OnlineOrder[]
  fiscalData         CustomerFiscalData?
  carts              Cart[]
  addresses          CustomerAddress[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  REFUNDED
}

enum OrderPaymentMethod {
  ONLINE_GATEWAY
  WHATSAPP_MANUAL
}

// --- P3: cart, coupons, shipping zones, saved addresses, order risk ---

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ORDER
  CATEGORY
  PRODUCT
}

/// P5 — A/B price tests (assignment/splitting is a future concern; this stores the experiment definition)
enum PriceExperimentWinnerCriteria {
  REVENUE
  CONVERSION_RATE
}

model Cart {
  id           String   @id @default(uuid())
  sessionToken String?  @unique @db.VarChar(80)
  customerId   String?  @unique
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id                  String @id @default(uuid())
  cartId              String
  productId           String
  variantId           String
  quantity            Int
  priceAtAdd          Decimal @db.Decimal(10, 2)
  productNameSnapshot String

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Coupon {
  id               String      @id @default(uuid())
  code             String      @unique @db.VarChar(40)
  type             CouponType
  /// Discount percent (0–100) or fixed COP amount depending on type
  value            Decimal     @db.Decimal(10, 2)
  scope            CouponScope @default(ORDER)
  categoryId       String?
  productId        String?
  validFrom        DateTime?
  validUntil       DateTime?
  maxUses          Int?
  usedCount        Int         @default(0)
  perCustomerLimit Int?
  minOrderAmount   Decimal?    @db.Decimal(10, 2)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  couponRedemptions CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  orderId         String   @unique
  customerId      String?
  discountApplied Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  coupon Coupon      @relation(fields: [couponId], references: [id])
  order  OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

model ShippingZone {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(40)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  rates ShippingRate[]
}

model ShippingRate {
  id        String   @id @default(uuid())
  zoneId    String
  code      String   @default("STANDARD") @db.VarChar(40)
  baseFee   Decimal  @db.Decimal(10, 2)
  perKg     Decimal? @db.Decimal(10, 4)
  freeAbove Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, code])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  label       String?  @db.VarChar(80)
  line1       String
  line2       String?
  city        String
  department  String
  countryCode String   @default("CO") @db.VarChar(2)
  postalCode  String?
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   OnlineOrder[]
}

model OnlineOrder {
  id                      String             @id @default(uuid())
  orderNumber             Int                @unique @default(autoincrement())
  customerId              String?
  guestName               String?
  guestPhone              String?
  guestEmail              String?
  shippingAddress         String
  status                  OrderStatus        @default(PENDING_PAYMENT)
  /// Gross total charged (tax-inclusive line totals); legacy rows backfilled from totalAmount
  totalAmount             Decimal            @db.Decimal(10, 2)
  /// Net of tax (derived); nullable for legacy rows
  subtotalAmount          Decimal?           @db.Decimal(10, 2)
  taxAmount               Decimal?           @db.Decimal(10, 2)
  shippingAmount          Decimal?           @db.Decimal(10, 2)
  discountAmount          Decimal?           @db.Decimal(10, 2)
  currencyCode            String             @default("COP")
  paymentMethod           OrderPaymentMethod
  paymentGatewayReference String?            @unique
  paymentUrl              String?
  expiresAt               DateTime?
  paidAt                  DateTime?
  stockRestoredAt         DateTime?
  /// Request metadata for future antifraud / forensics (no scoring in P0)
  ipAddress               String?
  userAgent               String?
  deviceFingerprintHash   String?
  createdAt               DateTime           @default(now())

  /// P3 antifraud / checkout enrichment (nullable on legacy rows)
  riskScore            Int?
  riskTier             String? @db.VarChar(24)
  couponCodeSnapshot   String? @db.VarChar(40)
  customerAddressId    String?
  shippingZoneCode     String? @db.VarChar(40)

  /// Snapshot envío — obligatorio en checkout (transportista); legacy puede ser null
  shippingRecipientName           String? @db.VarChar(120)
  shippingRecipientDocumentType   String? @db.VarChar(4)
  shippingRecipientDocumentNumber String? @db.VarChar(32)
  shippingLine1                   String? @db.VarChar(300)
  shippingLine2                   String? @db.VarChar(200)
  shippingCity                    String? @db.VarChar(120)
  shippingDepartment              String? @db.VarChar(120)
  shippingPostalCode              String? @db.VarChar(16)
  shippingRecipientPhone          String? @db.VarChar(30)

  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerAddressRef CustomerAddress?  @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  items              OnlineOrderItem[]
  events             OrderEvent[]
  ledgerEntries      LedgerEntry[]
  invoices           ElectronicInvoice[]
  couponRedemption   CouponRedemption?

  @@index([status, expiresAt], map: "OnlineOrder_pending_expired_idx")
}

/// Stores replay responses for POST Idempotency-Key (payments, sales, online orders)
model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String
  operation    String
  bodyHash     String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([key, operation])
}

model ProcessedWebhook {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean
  description String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OnlineOrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  productId           String
  variantId           String?
  quantity            Int
  unitPrice           Decimal @db.Decimal(10, 2)
  productNameSnapshot String

  order   OnlineOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([variantId])
}

/// P2: append-only style audit of order status transitions (operational, not financial)
model OrderEvent {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  order OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// P2: financial ledger (append-only; Client.balance remains materialized until a later contract phase)
model LedgerEntry {
  id             String          @id @default(uuid())
  clientId       String
  saleId         String?
  paymentId      String?
  onlineOrderId  String?
  kind           LedgerEntryKind
  /// Signed: positive increases amount owed, negative decreases (payment)
  delta          Decimal         @db.Decimal(15, 2)
  balanceAfter   Decimal         @db.Decimal(15, 2)
  currencyCode   String          @default("COP")
  description    String          @db.VarChar(500)
  createdAt      DateTime        @default(now())

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sale   Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payment Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order   OnlineOrder? @relation(fields: [onlineOrderId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([saleId])
  @@index([paymentId])
}

/// P2: DIAN numbering container (integration P6 — schema only here)
model DianResolution {
  id                 String   @id @default(uuid())
  prefix             String
  rangeFrom          Int
  rangeTo            Int
  validFrom          DateTime
  validUntil         DateTime
  resolutionNumber   String
  technicalKey       String?
  isActive           Boolean  @default(true)
  currentConsecutive Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoices ElectronicInvoice[]
}

model ElectronicInvoice {
  id                 String                 @id @default(uuid())
  saleId             String?                @unique
  onlineOrderId      String?                @unique
  resolutionId       String?
  prefix             String?
  consecutive        Int?
  cufe               String?                @unique
  issueDate          DateTime?
  type               ElectronicInvoiceType  @default(INVOICE)
  customerNit        String?
  customerDocumentType String?
  customerLegalName  String?
  customerEmail      String?
  customerAddress    String?
  subtotal           Decimal?               @db.Decimal(15, 2)
  totalIva           Decimal?               @db.Decimal(15, 2)
  totalRetention     Decimal?               @db.Decimal(15, 2)
  total              Decimal?               @db.Decimal(15, 2)
  status             ElectronicInvoiceStatus @default(DRAFT)
  providerResponse   Json?
  providerTrackId    String?
  pdfUrl             String?
  xmlUrl             String?
  sentToCustomerAt   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  sale        Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  onlineOrder OnlineOrder?   @relation(fields: [onlineOrderId], references: [id], onDelete: SetNull)
  resolution  DianResolution? @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  items       ElectronicInvoiceItem[]
  auditTrail  InvoiceAuditLog[]
}

model ElectronicInvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(15, 2)
  ivaRate     Decimal? @db.Decimal(5, 2)
  ivaAmount   Decimal? @db.Decimal(15, 2)
  subtotal    Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)

  invoice ElectronicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceAuditLog {
  id         String                  @id @default(uuid())
  invoiceId  String
  fromStatus ElectronicInvoiceStatus?
  toStatus   ElectronicInvoiceStatus
  detail     String?
  createdAt  DateTime                @default(now())

  invoice ElectronicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Fiscal profile for B2C (Customer) or B2B staff Client — at most one row per side
model CustomerFiscalData {
  id             String       @id @default(uuid())
  customerId     String?      @unique
  clientId       String?      @unique
  documentType   String
  documentNumber String
  legalName      String
  dvCode         String?
  regimeType     String?
  taxAddress     String?
  taxCity        String?
  taxDepartment  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
