generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SELLER
}

enum SaleType {
  CASH
  CREDIT
}

enum SaleStatus {
  PAID
  PENDING
  PARTIAL
}

enum InstallmentFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum DocumentType {
  CC  // Cédula de ciudadanía
  CE  // Cédula de extranjería
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SELLER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model Client {
  id             String       @id @default(uuid())
  name           String
  phone          String
  email          String?
  documentType   DocumentType
  documentNumber String
  address        String
  neighborhood   String
  creditLimit    Decimal      @db.Decimal(10, 2)
  balance        Decimal      @default(0) @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales             Sale[]
  payments          Payment[]
  auditLogs         AuditLog[]
  notificationLogs  NotificationLog[]
  customer          Customer?
}

model Product {
  id          String   @id @default(uuid())
  name        String
  stock       Int      @default(0)
  retailPrice Decimal? @db.Decimal(10, 2)
  investmentCost Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category?         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  saleItems        SaleItem[]
  attributes       ProductAttribute[]
  onlineOrderItems OnlineOrderItem[]
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  attributes CategoryAttribute[]
}

model CategoryAttribute {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   AttributeValue[]

  @@unique([categoryId, name])
}

model AttributeValue {
  id          String   @id @default(uuid())
  attributeId String
  value       String
  createdAt   DateTime @default(now())

  attribute    CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productLinks ProductAttribute[]

  @@unique([attributeId, value])
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String
  valueId   String

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value   AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, valueId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Sale {
  id                String                @id @default(uuid())
  saleNumber        Int                   @unique @default(autoincrement())
  clientId          String
  type              SaleType
  status            SaleStatus            @default(PENDING)
  total             Decimal               @db.Decimal(10, 2)
  installmentsCount Int?                  // Null para ventas sin plan de cuotas
  frequency         InstallmentFrequency? // MONTHLY | BIWEEKLY — null si no es venta en cuotas
  installmentAmount Decimal?              @db.Decimal(10, 2) // (total - initialPayment) / installmentsCount
  initialPayment    Decimal?              @db.Decimal(10, 2) // Cuota inicial abonada al crear la venta (puede ser 0 o null)
  collectionDay     Int?                  // Día del mes para el cobro (1-31). Ej: 30 → cobra el día 30 de cada mes
  collectionDay2    Int?                  // Segundo día de cobro para planes BIWEEKLY. Ej: 15 → cobra el 15 y el collectionDay
  createdAt         DateTime              @default(now())

  client   Client     @relation(fields: [clientId], references: [id])
  items    SaleItem[]
  payments Payment[]

  // Partial composite index on (type, status, collectionDay) WHERE installmentsCount IS NOT NULL.
  // Prisma DSL does not support partial indexes — managed by raw migration
  // 20260506000000_add_active_credit_sales_index as "Sale_active_credit_idx".
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  quantity    Int
  basePrice   Decimal? @db.Decimal(10, 2) // Precio base del producto al momento de la venta (snapshot)
  unitPrice   Decimal  @db.Decimal(10, 2) // Precio final aplicado (puede incluir recargo de crédito)
  subtotal    Decimal  @db.Decimal(10, 2)
  appliedRule String?                     // Regla de pricing aplicada: "CASH_BASE" | "CREDIT_SURCHARGE_15PCT" | etc.

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  clientId  String
  saleId    String?
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  sale   Sale?  @relation(fields: [saleId], references: [id])

  // Composite index: accelerates bulk-load of payments by saleId (used by dashboard & GetCollectionsUseCase).
  // Created by migration 20260506000000_add_active_credit_sales_index.
  @@index([saleId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  clientId  String
  userId    String
  action    String
  before    Decimal  @db.Decimal(10, 2)
  after     Decimal  @db.Decimal(10, 2)
  ip        String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model NotificationLog {
  id           String   @id @default(uuid())
  clientId     String
  channel      String   // "WHATSAPP" | "EMAIL"
  event        String   // "PAYMENT_REGISTERED" | "CREDIT_SALE_CREATED"
  status       String   // "SENT" | "FAILED"
  errorMessage String?
  sentAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model Customer {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String?
  phone              String
  googleId           String?  @unique
  isActive           Boolean  @default(true)
  clientId           String?  @unique
  mustChangePassword Boolean  @default(false)
  address            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client             Client?       @relation(fields: [clientId], references: [id])
  onlineOrders       OnlineOrder[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum OrderPaymentMethod {
  ONLINE_GATEWAY
  WHATSAPP_MANUAL
}

model OnlineOrder {
  id                      String             @id @default(uuid())
  orderNumber             Int                @unique @default(autoincrement())
  customerId              String?
  guestName               String?
  guestPhone              String?
  guestEmail              String?
  shippingAddress         String
  status                  OrderStatus        @default(PENDING_PAYMENT)
  totalAmount             Decimal            @db.Decimal(10, 2)
  paymentMethod           OrderPaymentMethod
  paymentGatewayReference String?            @unique
  paymentUrl              String?
  expiresAt               DateTime?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())

  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OnlineOrderItem[]
}

model ProcessedWebhook {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model OnlineOrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  productId           String
  quantity            Int
  unitPrice           Decimal @db.Decimal(10, 2)
  productNameSnapshot String

  order   OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
}
